generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())
  favorites Favorite[]
}

model CelestialObject {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  objectType  String
  description String?
  source      String?
  updatedAt   DateTime @updatedAt
  favorites   Favorite[]
}

model Favorite {
  id                 String          @id @default(cuid())
  userId             String
  celestialObjectId  String
  createdAt          DateTime        @default(now())
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  celestialObject    CelestialObject @relation(fields: [celestialObjectId], references: [id], onDelete: Cascade)
  @@unique([userId, celestialObjectId])
}
